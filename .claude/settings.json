{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$(git rev-parse --show-toplevel)/.claude/hooks/start-reminder.txt\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
