// The views of the model (#928). A view `of` an element opens when you click that element in a
// view above it, so the site drills down: context → modules → components. Keep a component view
// to about ten elements: include its module's components and only the neighbours that explain them.

views {
  view index {
    title 'Context: Ephyra and what it talks to'
    description 'Level 1. Click Ephyra to see its modules.'
    include viewer, ephyra, jellyfin, castReceiver, android
  }

  view modules of ephyra {
    title 'Containers: the Gradle modules'
    description 'Level 2, generated from the build files. Production dependencies only. Left out: the arrows into domain and application, which every module may use (application -> domain stays); the arrows of the apps, which depend on every module (view apps); tests and tooling. modules.md has every dependency. Click a module with components to open it.'
    include *
    exclude ephyra.architecture, ephyra.testing, ephyra.baselineprofile, ephyra.baselineprofileTv
    exclude * -[test]-> *
    exclude ephyra.appPhone -> *, ephyra.appTv -> *
    exclude * -> ephyra.domain, * -> ephyra.application
    include ephyra.application -> ephyra.domain
  }

  view apps of ephyra.appPhone {
    title 'Containers: the apps, the composition root'
    description 'Only the apps depend on the adapters data and server/jellyfin (rules R7, R9); Hilt wires the ports to them there.'
    include ephyra.appPhone, ephyra.appTv
    include ephyra.appPhone -> *, ephyra.appTv -> *
    exclude * -[test]-> *
    exclude ephyra.baselineprofile, ephyra.baselineprofileTv
  }

  view tooling of ephyra.testing {
    title 'Tests and tooling modules'
    include ephyra.testing, ephyra.architecture, ephyra.baselineprofile, ephyra.baselineprofileTv
    include ephyra.domain, ephyra.appPhone, ephyra.appTv
  }

  view playerLocal of ephyra.playerLocal {
    title 'Components: player/local'
    description 'Level 3. The player behind PlayerEngine (ADR 0001, decision 4) and its use cases, which reach the server and the downloads through MediaRepository.'
    include ephyra.playerLocal, ephyra.playerLocal.*
    include ephyra.application.mediaRepository, ephyra.domain.downloadState
  }

  view downloads of ephyra.downloads {
    title 'Components: downloads'
    description 'Level 3. The download queue and engine (#901). Rule R15: downloads uses no adapter and not core; what it needs comes through the ports in application. Guide: areas/downloads.'
    include ephyra.downloads, ephyra.downloads.*
    include ephyra.application.downloadStore, ephyra.application.downloadSettings, ephyra.application.mediaRepository
    include ephyra.core.downloaderViewModel
  }

  view core of ephyra.core {
    title 'Components: core'
    description 'Level 3. The server in use, its session and reachability, the sync of user data written without the server, and the download state for the item screens.'
    include ephyra.core, ephyra.core.*
    include ephyra.domain.mediaServer, ephyra.domain.activeServer
    include ephyra.application.serverStore, ephyra.application.pendingUserDataStore
    include ephyra.downloads.downloadQueue
  }

  view setup of ephyra.setup {
    title 'Components: setup'
    description 'Level 3. Finding a server and signing in, through the ServerConnector port; the server in use is switched whole (rule R16). Guide: areas/setup-and-servers.'
    include ephyra.setup, ephyra.setup.*
    include ephyra.domain.serverConnector, ephyra.domain.activeServer, ephyra.application.serverStore
    include ephyra.serverJellyfin.jellyfinServerConnector
  }

  view domain of ephyra.domain {
    title 'Components: domain'
    description 'The server ports, the server in use and the two domain models with rules (ADR 0002), with what implements the ports.'
    include ephyra.domain, ephyra.domain.*
    include ephyra.serverJellyfin.jellyfinMediaServer, ephyra.serverJellyfin.jellyfinPlayback, ephyra.serverJellyfin.jellyfinServerConnector
    include ephyra.core.currentMediaServer
  }

  view application of ephyra.application {
    title 'Components: application'
    description 'The ports the features call, implemented in data (DownloadSettings over AppPreferences in core).'
    include ephyra.application, ephyra.application.*
    include ephyra.data.*
  }

  view serverJellyfin of ephyra.serverJellyfin {
    title 'Components: server/jellyfin'
    description 'The Jellyfin adapter, the only module with the Jellyfin SDK (rules R1 to R3).'
    include ephyra.serverJellyfin, ephyra.serverJellyfin.*, jellyfin
    include ephyra.domain.mediaServer, ephyra.domain.playbackPort, ephyra.domain.serverConnector
  }

  view data of ephyra.data {
    title 'Components: data'
    description 'Room and the repository over the server in use; only the apps depend on data (rule R9).'
    include ephyra.data, ephyra.data.*
    include ephyra.application.mediaRepository, ephyra.application.serverStore, ephyra.application.downloadStore, ephyra.application.pendingUserDataStore
    include ephyra.domain.mediaServer, ephyra.domain.playState
  }
}
