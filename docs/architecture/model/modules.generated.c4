// Generated by architecture/…/GeneratedDocsTest.kt from the build files and the rule tests. Don't edit:
// EPHYRA_WRITE_GENERATED=1 ./gradlew :architecture:test --rerun --tests '*GeneratedDocsTest*'

model {
  extend ephyra {
    appPhone = app 'app/phone' {
      description 'The phone app: screens, navigation and layouts; with app/tv the composition root.'
      link https://github.com/midasvo/ephyra/tree/main/app/phone 'Source'
    }
    appTv = app 'app/tv' {
      description 'The Android TV app, with its own screens.'
      link https://github.com/midasvo/ephyra/tree/main/app/tv 'Source'
    }
    application = application 'application' {
      description 'Pure Kotlin: MediaRepository, the store ports and the event flows.'
      link https://github.com/midasvo/ephyra/tree/main/application 'Source'
    }
    architecture = tooling 'architecture' {
      description 'The Konsist rules over the source tree, and the generated architecture docs.'
      link https://github.com/midasvo/ephyra/tree/main/architecture 'Source'
    }
    baselineprofile = tooling 'baselineprofile' {
      description 'The baseline profile and startup benchmark of app/phone.'
      link https://github.com/midasvo/ephyra/tree/main/baselineprofile 'Source'
    }
    baselineprofileTv = tooling 'baselineprofile-tv' {
      description 'The baseline profile and startup benchmark of app/tv.'
      link https://github.com/midasvo/ephyra/tree/main/baselineprofile-tv 'Source'
    }
    core = feature 'core' {
      description 'Hilt modules, the server in use, its session and reachability, the sync, shared Composables.'
      link https://github.com/midasvo/ephyra/tree/main/core 'Source'
    }
    data = adapter 'data' {
      description 'Room: the database, the stores, and MediaRepositoryImpl over the server\'s ports.'
      link https://github.com/midasvo/ephyra/tree/main/data 'Source'
    }
    domain = domain 'domain' {
      description 'Pure Kotlin: the models, the ids, the rules of user data and downloads, the server ports.'
      link https://github.com/midasvo/ephyra/tree/main/domain 'Source'
    }
    downloads = feature 'downloads' {
      description 'The download engine, the download queue and smart downloads.'
      link https://github.com/midasvo/ephyra/tree/main/downloads 'Source'
    }
    modesFilm = feature 'modes/film' {
      description 'The view models of home, library, search, the item screens and downloads.'
      link https://github.com/midasvo/ephyra/tree/main/modes/film 'Source'
    }
    playerCast = feature 'player/cast' {
      description 'Google Cast: the session and playback on a receiver (stubs in the libre flavour).'
      link https://github.com/midasvo/ephyra/tree/main/player/cast 'Source'
    }
    playerCore = feature 'player/core' {
      description 'The player models shared by the player and its callers.'
      link https://github.com/midasvo/ephyra/tree/main/player/core 'Source'
    }
    playerLocal = feature 'player/local' {
      description 'The player: PlayerViewModel and playback, on ExoPlayer or mpv behind PlayerEngine.'
      link https://github.com/midasvo/ephyra/tree/main/player/local 'Source'
    }
    serverJellyfin = adapter 'server/jellyfin' {
      description 'The Jellyfin adapter, the only module with the Jellyfin SDK.'
      link https://github.com/midasvo/ephyra/tree/main/server/jellyfin 'Source'
    }
    settings = feature 'settings' {
      description 'The app\'s preferences and the settings screen.'
      link https://github.com/midasvo/ephyra/tree/main/settings 'Source'
    }
    setup = feature 'setup' {
      description 'Finding a server and signing in.'
      link https://github.com/midasvo/ephyra/tree/main/setup 'Source'
    }
    testing = tooling 'testing' {
      description 'Test only: a fake server and the contract suites a server adapter passes.'
      link https://github.com/midasvo/ephyra/tree/main/testing 'Source'
    }

    appPhone -> application
    appPhone -> baselineprofile
    appPhone -> core
    appPhone -> data
    appPhone -> domain
    appPhone -> downloads
    appPhone -> modesFilm
    appPhone -> playerCast
    appPhone -> playerCore
    appPhone -> playerLocal
    appPhone -> serverJellyfin
    appPhone -> settings
    appPhone -> setup
    appTv -> application
    appTv -> core
    appTv -> data
    appTv -> domain
    appTv -> downloads
    appTv -> modesFilm
    appTv -> playerCore
    appTv -> playerLocal
    appTv -> serverJellyfin
    appTv -> settings
    appTv -> setup
    appTv -[test]-> testing
    application -> domain
    baselineprofile -> appPhone
    baselineprofileTv -> appTv
    core -> application
    core -[test]-> data
    core -> domain
    core -> downloads
    core -> playerCore
    core -> settings
    core -[test]-> testing
    data -> application
    data -> domain
    data -[test]-> testing
    downloads -> application
    downloads -[test]-> data
    downloads -> domain
    downloads -> settings
    downloads -[test]-> testing
    modesFilm -> application
    modesFilm -> core
    modesFilm -[test]-> data
    modesFilm -> domain
    modesFilm -> downloads
    modesFilm -> settings
    modesFilm -[test]-> testing
    playerCast -> application
    playerCast -> core
    playerCast -> domain
    playerCast -> playerCore
    playerCast -> playerLocal
    playerCast -> settings
    playerCore -> domain
    playerLocal -> application
    playerLocal -> core
    playerLocal -[test]-> data
    playerLocal -> domain
    playerLocal -> playerCore
    playerLocal -> settings
    playerLocal -[test]-> testing
    serverJellyfin -> application
    serverJellyfin -[test]-> data
    serverJellyfin -> domain
    serverJellyfin -> settings
    serverJellyfin -[test]-> testing
    settings -> domain
    setup -> application
    setup -> core
    setup -[test]-> data
    setup -> domain
    setup -> settings
    setup -[test]-> testing
    testing -> application
    testing -> domain
  }
}
